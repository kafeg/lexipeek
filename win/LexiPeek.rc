// The executable's icons (the app's; the tray's glyph white and black, from scripts/gen-icons.sh) and version
// (version.h: written into the build by cmake/win_shell.cmake).
#include <winver.h>
#include "resource.h"
#include "version.h"
IDI_APP ICON "..\\qt\\icons\\lexipeek.ico"
IDI_TRAY_WHITE ICON "..\\qt\\icons\\tray_white.ico"
IDI_TRAY_BLACK ICON "..\\qt\\icons\\tray_black.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,LEXIPEEK_COMMITS,0
PRODUCTVERSION 0,1,LEXIPEEK_COMMITS,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "LexiPeek"
      VALUE "FileVersion", LEXIPEEK_VERSION
      VALUE "ProductName", "LexiPeek"
      VALUE "ProductVersion", LEXIPEEK_VERSION
      VALUE "OriginalFilename", "LexiPeek.exe"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
