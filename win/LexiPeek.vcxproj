<?xml version="1.0" encoding="utf-8"?>
<!-- The Windows shell: WinUI 3 (C++/WinRT), unpackaged and self-contained, over the core and the shared OS layer (platform/) built by CMake.
     scripts/build-win.cmd: msbuild win\LexiPeek.vcxproj -p:Configuration=Release -p:Platform=x64 -p:LexiPeekBuild=<cmake build dir> -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Build>$(LexiPeekBuild)</Build>
    <Build Condition="'$(Build)'==''">$(MSBuildThisFileDirectory)..\build-win</Build>
    <Build>$([MSBuild]::EnsureTrailingSlash('$(Build)'))</Build>
    <Packages>$(Build)packages\</Packages>
  </PropertyGroup>
  <Import Project="$(Packages)Microsoft.Windows.CppWinRT.3.0.260818.1\build\native\Microsoft.Windows.CppWinRT.props" />
  <Import Project="$(Packages)Microsoft.Windows.SDK.BuildTools.10.0.28000.2957\build\Microsoft.Windows.SDK.BuildTools.props" />
  <Import Project="$(Packages)Microsoft.Windows.SDK.BuildTools.MSIX.1.7.251221100\build\Microsoft.Windows.SDK.BuildTools.MSIX.props" />
  <Import Project="$(Packages)Microsoft.WindowsAppSDK.Base.2.6.4\build\native\Microsoft.WindowsAppSDK.Base.props" />
  <Import Project="$(Packages)Microsoft.WindowsAppSDK.InteractiveExperiences.2.6.4\build\native\Microsoft.WindowsAppSDK.InteractiveExperiences.props" />
  <Import Project="$(Packages)Microsoft.WindowsAppSDK.Foundation.2.6.4\build\native\Microsoft.WindowsAppSDK.Foundation.props" />
  <Import Project="$(Packages)Microsoft.WindowsAppSDK.WinUI.2.6.4\build\native\Microsoft.WindowsAppSDK.WinUI.props" />
  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{6F0C2D9A-3B1E-4C57-9A0D-2E7B8C4F1A63}</ProjectGuid>
    <ProjectName>LexiPeek</ProjectName>
    <RootNamespace>LexiPeek</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppContainerApplication>false</AppContainerApplication>
    <AppxPackage>false</AppxPackage>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WebView2UseWinRT>true</WebView2UseWinRT>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(Build)win\bin\</OutDir>
    <IntDir>$(Build)win\obj\</IntDir>
    <GeneratedFilesDir>$(IntDir)Generated Files\</GeneratedFilesDir>
    <TargetName>LexiPeek</TargetName>
  </PropertyGroup>
  <!-- The core's include dirs and its whole link closure, written by CMake (cmake/win_shell.cmake). -->
  <Import Project="$(Build)win\lexipeek-core.props" Condition="Exists('$(Build)win\lexipeek-core.props')" />
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /utf-8</AdditionalOptions>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;NOMINMAX;DISABLE_XAML_GENERATED_MAIN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization>MaxSpeed</Optimization>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <AdditionalDependencies>windowscodecs.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Manifest Include="app.manifest" />
    <ClInclude Include="pch.h" />
    <ClInclude Include="App.xaml.h">
      <DependentUpon>App.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="MainWindow.xaml.h">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClInclude>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="App.xaml.cpp">
      <DependentUpon>App.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="MainWindow.xaml.cpp">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClCompile>
    <ClInclude Include="card_stub.hpp" />
    <ClInclude Include="core_client.hpp" />
    <ClInclude Include="dicts_pane.hpp" />
    <ClInclude Include="packs_pane.hpp" />
    <ClInclude Include="resource.h" />
    <ClInclude Include="settings_ui.hpp" />
    <ClInclude Include="settings_window.hpp" />
    <ClInclude Include="shell.hpp" />
    <ClInclude Include="snapshots.hpp" />
    <ClInclude Include="tray.hpp" />
    <ClInclude Include="ui.hpp" />
    <ClCompile Include="card_stub.cpp" />
    <ClCompile Include="core_client.cpp" />
    <ClCompile Include="dicts_pane.cpp" />
    <ClCompile Include="packs_pane.cpp" />
    <ClCompile Include="settings_ui.cpp" />
    <ClCompile Include="settings_window.cpp" />
    <ClCompile Include="shell.cpp" />
    <ClCompile Include="snapshots.cpp" />
    <ClCompile Include="tray.cpp" />
    <ClCompile Include="ui.cpp" />
    <ResourceCompile Include="LexiPeek.rc" />
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
    <XamlGenerated Include="$(IntDir)XamlTypeInfo.g.cpp;$(IntDir)XamlTypeInfo.Impl.g.cpp;$(IntDir)XamlLibMetadataProvider.g.cpp" />
    <ClCompile Include="@(XamlGenerated)" Condition="!Exists('$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.Cpp.targets')" />
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Midl Include="MainWindow.idl">
      <SubType>Code</SubType>
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Midl>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(Packages)Microsoft.Windows.CppWinRT.3.0.260818.1\build\native\Microsoft.Windows.CppWinRT.targets" />
  <Import Project="$(Packages)Microsoft.Windows.SDK.BuildTools.10.0.28000.2957\build\Microsoft.Windows.SDK.BuildTools.targets" />
  <Import Project="$(Packages)Microsoft.Windows.SDK.BuildTools.MSIX.1.7.251221100\build\Microsoft.Windows.SDK.BuildTools.MSIX.targets" />
  <Import Project="$(Packages)Microsoft.WindowsAppSDK.Base.2.6.4\build\native\Microsoft.WindowsAppSDK.Base.targets" />
  <Import Project="$(Packages)Microsoft.WindowsAppSDK.InteractiveExperiences.2.6.4\build\native\Microsoft.WindowsAppSDK.InteractiveExperiences.targets" />
  <Import Project="$(Packages)Microsoft.WindowsAppSDK.Foundation.2.6.4\build\native\Microsoft.WindowsAppSDK.Foundation.targets" />
  <Import Project="$(Packages)Microsoft.WindowsAppSDK.WinUI.2.6.4\build\native\Microsoft.WindowsAppSDK.WinUI.targets" />
  <Import Project="$(Packages)Microsoft.Web.WebView2.1.0.3719.77\build\native\Microsoft.Web.WebView2.targets" />
  <!-- The XAML compiler's place in a C++ build, as Visual Studio's WindowsXaml C++ targets put it (Build Tools have none). -->
  <PropertyGroup Condition="!Exists('$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.Cpp.targets')">
    <BeforeMidlCompileTargets>ResolveReferences;MarkupCompilePass1;$(BeforeMidlCompileTargets)</BeforeMidlCompileTargets>
    <BeforeClCompileTargets>ComputeReferenceCLInput;MarkupCompilePass2;$(BeforeClCompileTargets)</BeforeClCompileTargets>
  </PropertyGroup>
  <Target Name="CompileXamlGenerated" AfterTargets="CppWinRTComputeXamlGeneratedCompileInputs"
          Condition="!Exists('$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.Cpp.targets')">
    <ItemGroup>
      <ClCompile Condition="'%(ClCompile.CompilerIteration)'=='XamlGenerated'">
        <CompilerIteration></CompilerIteration>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
