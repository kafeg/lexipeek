<Window x:Class="LexiPeek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexiPeek">
  <NavigationView x:Name="Nav" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" PaneDisplayMode="Left">
    <NavigationView.MenuItems>
      <NavigationViewItem x:Name="LookupItem" Tag="lookup" IsSelected="True">
        <NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="NotesItem" Tag="notes">
        <NavigationViewItem.Icon><SymbolIcon Symbol="Bookmarks" /></NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>
    <ScrollViewer>
      <StackPanel x:Name="Lines" Padding="24" Spacing="8" />
    </ScrollViewer>
  </NavigationView>
</Window>
