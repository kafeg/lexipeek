<!-- The LexiPeek window (qt/main_window, mac MainWindow) as Windows 11's Settings app: Look up · Words · Phrases · History ·
     Help in a NavigationView, the memory line, Settings and About at its foot; the pages drawn by MainWindow.xaml.cpp. -->
<Window x:Class="LexiPeek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexiPeek">
  <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="Transparent">
      <TextBlock Text="LexiPeek" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
    <NavigationView x:Name="Nav" Grid.Row="1" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" PaneDisplayMode="Left"
                    IsPaneToggleButtonVisible="False" OpenPaneLength="260" IsTitleBarAutoPaddingEnabled="False">
      <NavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
      </NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="LookupItem" Tag="lookup" IsSelected="True">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="WordsItem" Tag="words">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="PhrasesItem" Tag="phrases">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="HistoryItem" Tag="history">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="HelpItem" Tag="help">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <TextBlock x:Name="Memory" Margin="16,4,16,12" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </NavigationView.PaneFooter>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="SettingsItem" Tag="settings" SelectsOnInvoked="False">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="AboutItem" Tag="about" SelectsOnInvoked="False">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- No language pack yet: the InfoBar over every page. -->
        <InfoBar x:Name="NoPack" Severity="Warning" IsClosable="False" IsOpen="False" Margin="36,0,36,12" />
        <!-- Look up: the query over the embedded card (or the hint while there is none). -->
        <Grid x:Name="LookupPage" Grid.Row="1" RowSpacing="12" Padding="36,4,36,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBox x:Name="Query" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" MinHeight="36" Padding="12,7,12,6"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Query" />
          <Border x:Name="CardFrame" Grid.Row="1" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0,4,0,0" />
          <TextBlock x:Name="Hint" Grid.Row="1" MaxWidth="440" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="0,0,0,48" Style="{StaticResource BodyTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <!-- Words · Phrases · History: the list's page, its commands, the backup. -->
        <Grid x:Name="NotesPage" Grid.Row="1" Visibility="Collapsed" Padding="36,0,36,24" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="NotesHeading" Style="{StaticResource TitleTextBlockStyle}" Margin="0,4,0,4" />
          <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="8">
            <Grid>
              <ListView x:Name="Rows" SelectionMode="Single" IsItemClickEnabled="True" Padding="0,4,0,4" AutomationProperties.AutomationId="Rows" />
              <TextBlock x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                         MaxWidth="400" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
          </Border>
          <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="Tsv" MinWidth="96" AutomationProperties.AutomationId="Tsv" />
            <StackPanel x:Name="Pager" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock x:Name="PagerText" VerticalAlignment="Center" Margin="4,0,4,0" Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="Clear" Grid.Column="2" HorizontalAlignment="Right" />
          </Grid>
          <StackPanel Grid.Row="3" Spacing="4">
            <Grid x:Name="Backup" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="16,12,16,12" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE8F7;" FontSize="20" Margin="4,0,12,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="BackupTitle" Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock x:Name="BackupAbout" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <Button x:Name="Export" Grid.Column="2" MinWidth="96" VerticalAlignment="Center" />
              <Button x:Name="Import" Grid.Column="3" MinWidth="96" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="Said" Margin="4,0,0,0" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Grid>
        <!-- Help: every topic on one page, each with the Settings pane it is about. -->
        <ScrollViewer x:Name="HelpPage" Grid.Row="1" Visibility="Collapsed">
          <StackPanel Padding="36,0,36,36">
            <TextBlock x:Name="HelpHeading" Style="{StaticResource TitleTextBlockStyle}" Margin="0,4,0,8" />
            <StackPanel x:Name="Topics" Spacing="4" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
