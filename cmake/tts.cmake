# Read aloud (spec M9): qwentts.cpp (MIT) as its own shared library — only its C ABI (qt_*) exported, its ggml fork inside
# (llama.cpp's ggml is another copy: the two cannot be linked into one binary). Metal on macOS, Vulkan on Windows.
# Windows' shells link it once the WinUI card plays (TODO.md); until then CI builds the library there on its own
# (LEXIPEEK_TTS_LIBRARY: built, not linked).
if(APPLE)
  option(LEXIPEEK_TTS "Read aloud (qwentts.cpp)" ON)
else()
  option(LEXIPEEK_TTS "Read aloud (qwentts.cpp)" OFF)
endif()
option(LEXIPEEK_TTS_LIBRARY "Build Read aloud's library without linking it" OFF)

# The library's own build: a separate CMake project (its ggml next to llama.cpp's would clash as targets too).
function(lexipeek_qwentts_args out)
  set(args -DCMAKE_BUILD_TYPE=Release -DQWEN_SHARED=ON -DBUILD_SHARED_LIBS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON
      -DGGML_NATIVE=OFF -DGGML_OPENMP=OFF -DGGML_BACKEND_DL=OFF -DCMAKE_POLICY_VERSION_MINIMUM=3.5)
  if(APPLE)
    # Its Objective-C class renamed: the runtime has one name space for both ggml copies' classes.
    list(APPEND args -DGGML_METAL=ON -DGGML_METAL_EMBED_LIBRARY=ON -DGGML_BLAS=OFF -DCMAKE_OSX_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET}
         -DCMAKE_OSX_ARCHITECTURES=arm64 -DGGML_CPU_ARM_ARCH=armv8.2-a+dotprod "-DCMAKE_OBJC_FLAGS=-DGGMLMetalClass=QwenGGMLMetalClass"
         -DCMAKE_INSTALL_NAME_DIR=@rpath -DCMAKE_BUILD_WITH_INSTALL_NAME_DIR=ON "-DCMAKE_SHARED_LINKER_FLAGS=-Wl,-exported_symbol,_qt_*")
  elseif(WIN32)
    # Vulkan's headers, loader library and glslc from vcpkg, as llama.cpp's (cmake/engines.cmake).
    list(APPEND args -DGGML_VULKAN=ON -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded -DCMAKE_POLICY_DEFAULT_CMP0091=NEW
         -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON -DVulkan_GLSLC_EXECUTABLE=${Vulkan_GLSLC_EXECUTABLE}
         -DCMAKE_PREFIX_PATH=${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET})
  endif()
  set(${out} ${args} PARENT_SCOPE)
endfunction()

if(LEXIPEEK_TTS OR LEXIPEEK_TTS_LIBRARY)
  include(ExternalProject)
  lexipeek_qwentts_args(QWENTTS_ARGS)
  set(QWENTTS_DIR ${CMAKE_BINARY_DIR}/engines/qwentts)
  if(WIN32)
    set(QWENTTS_LIB ${QWENTTS_DIR}/qwen.dll)
  else()
    set(QWENTTS_LIB ${QWENTTS_DIR}/${CMAKE_SHARED_LIBRARY_PREFIX}qwen${CMAKE_SHARED_LIBRARY_SUFFIX})
  endif()
  ExternalProject_Add(qwentts_build
    SOURCE_DIR ${PROJECT_SOURCE_DIR}/engines/qwentts
    BINARY_DIR ${QWENTTS_DIR}
    CMAKE_GENERATOR ${CMAKE_GENERATOR}
    CMAKE_ARGS ${QWENTTS_ARGS}
    BUILD_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> --config Release --target qwen
    INSTALL_COMMAND ""
    BUILD_BYPRODUCTS ${QWENTTS_LIB} ${QWENTTS_DIR}/qwen.lib
    USES_TERMINAL_BUILD ON)
  add_library(qwentts SHARED IMPORTED GLOBAL)
  set_target_properties(qwentts PROPERTIES IMPORTED_LOCATION ${QWENTTS_LIB} IMPORTED_IMPLIB ${QWENTTS_DIR}/qwen.lib
                        INTERFACE_INCLUDE_DIRECTORIES ${PROJECT_SOURCE_DIR}/engines/qwentts/src)
  add_dependencies(qwentts qwentts_build)
  # The library is not there yet when a fresh build configures: CMake would not add its folder to the programs' rpath.
  if(APPLE)
    list(APPEND CMAKE_BUILD_RPATH ${QWENTTS_DIR})
  endif()
endif()

# The voices in the app (core/src/speech/voices/<lang>-<female|male>.{spk,rvq,txt}) as one C++ table: kilobytes each.
function(lexipeek_embed_voices dir out)
  file(GLOB texts CONFIGURE_DEPENDS ${dir}/*.txt)
  set(arrays "")
  set(rows "")
  set(n 0)
  foreach(t IN LISTS texts)
    get_filename_component(id ${t} NAME_WE)
    string(REGEX REPLACE "-.*" "" lang ${id})
    file(READ ${t} said)
    string(STRIP "${said}" said)
    foreach(ext spk rvq)
      file(READ ${dir}/${id}.${ext} hex HEX)
      string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
      string(APPEND arrays "const unsigned char v${n}_${ext}[] = {${hex}};\n")
    endforeach()
    string(APPEND rows "    {\"${id}\", \"${lang}\", R\"voice(${said})voice\", v${n}_spk, sizeof v${n}_spk, v${n}_rvq, sizeof v${n}_rvq},\n")
    math(EXPR n "${n} + 1")
  endforeach()
  set(content "// Generated by cmake/tts.cmake from core/src/speech/voices/.\n${arrays}const std::vector<Embedded> embedded{\n${rows}};\n")
  if(EXISTS ${out})
    file(READ ${out} old)
  endif()
  if(NOT "${old}" STREQUAL "${content}")
    file(WRITE ${out} "${content}")
  endif()
endfunction()
