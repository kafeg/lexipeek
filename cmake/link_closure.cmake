# A target's whole link closure for a shell built outside CMake (Xcode, MSBuild): static library files into the global
# property <out_libs>, system libraries and linker flags into <out_flags>; generator expressions it cannot settle here
# (vcpkg's per-config ones) into <out_libs>_GENEX, for file(GENERATE) to evaluate; sources a target hands to its
# users (INTERFACE_SOURCES) into <out_libs>_SOURCES.
function(lexipeek_collect item out_libs out_flags)
  if(item MATCHES "^\\$<LINK_ONLY:(.+)>$")
    set(item ${CMAKE_MATCH_1})
  endif()
  if(item MATCHES "^\\$<IF:\\$<TARGET_EXISTS:([^>]+)>,([^,]+),([^>]+)>$")
    if(TARGET ${CMAKE_MATCH_1})
      set(item ${CMAKE_MATCH_2})
    else()
      set(item ${CMAKE_MATCH_3})
    endif()
  endif()
  if(item MATCHES "^::@")
    return()
  endif()
  if(item MATCHES "^\\$<")
    if(NOT APPLE)
      set_property(GLOBAL APPEND PROPERTY ${out_libs}_GENEX "${item}")
    endif()
    return()
  endif()
  get_property(seen GLOBAL PROPERTY LEXIPEEK_SEEN)
  if(item IN_LIST seen)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY LEXIPEEK_SEEN ${item})
  if(TARGET ${item})
    get_target_property(real ${item} ALIASED_TARGET)
    if(real)
      set(item ${real})
    endif()
    get_target_property(type ${item} TYPE)
    if(type STREQUAL "STATIC_LIBRARY")
      set_property(GLOBAL APPEND PROPERTY ${out_libs} "$<TARGET_FILE:${item}>")
    elseif(type STREQUAL "UNKNOWN_LIBRARY")
      # Find modules (OpenSSL, LibArchive): a file, a framework or a system library.
      foreach(p IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION)
        get_target_property(file ${item} ${p})
        if(file)
          lexipeek_collect(${file} ${out_libs} ${out_flags})
          break()
        endif()
      endforeach()
    endif()
    if(NOT APPLE)
      get_target_property(options ${item} INTERFACE_LINK_OPTIONS)
      if(options)
        set_property(GLOBAL APPEND PROPERTY ${out_flags} ${options})
      endif()
      get_target_property(sources ${item} INTERFACE_SOURCES)
      if(sources)
        set_property(GLOBAL APPEND PROPERTY ${out_libs}_SOURCES ${sources})
      endif()
    endif()
    get_target_property(deps ${item} INTERFACE_LINK_LIBRARIES)
    get_target_property(imported ${item} IMPORTED)
    if(NOT imported)
      get_target_property(own ${item} LINK_LIBRARIES)
      if(own)
        list(APPEND deps ${own})
      endif()
    endif()
    foreach(d IN LISTS deps)
      if(d)
        lexipeek_collect(${d} ${out_libs} ${out_flags})
      endif()
    endforeach()
  elseif(item MATCHES "\\.framework$")
    get_filename_component(name ${item} NAME_WE)
    set_property(GLOBAL APPEND PROPERTY ${out_flags} "-framework ${name}")
  elseif(item MATCHES "\\.(a|lib)$")
    set_property(GLOBAL APPEND PROPERTY ${out_libs} ${item})
  elseif(item MATCHES "\\.(dylib|tbd)$")
    get_filename_component(name ${item} NAME_WE)
    string(REGEX REPLACE "^lib" "" name ${name})
    set_property(GLOBAL APPEND PROPERTY ${out_flags} "-l${name}")
  elseif(item MATCHES "^[-/]")
    set_property(GLOBAL APPEND PROPERTY ${out_flags} ${item})
  elseif(APPLE)
    set_property(GLOBAL APPEND PROPERTY ${out_flags} "-l${item}")
  elseif(item MATCHES "::")
    message(FATAL_ERROR "${item}: an imported target not visible here (find_package it in this scope)")
  else()
    set_property(GLOBAL APPEND PROPERTY ${out_libs} "${item}.lib")
  endif()
endfunction()
