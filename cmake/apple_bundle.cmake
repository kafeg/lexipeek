# macOS: one static library of the core, the engines and the vcpkg libraries for the Swift app (mac/), plus what it links.
function(lexipeek_collect item out_libs out_flags)
  if(item MATCHES "^\\$<LINK_ONLY:(.+)>$")
    set(item ${CMAKE_MATCH_1})
  endif()
  if(item MATCHES "^(\\$<|::@)")
    return()
  endif()
  get_property(seen GLOBAL PROPERTY LEXIPEEK_SEEN)
  if(item IN_LIST seen)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY LEXIPEEK_SEEN ${item})
  if(TARGET ${item})
    get_target_property(real ${item} ALIASED_TARGET)
    if(real)
      set(item ${real})
    endif()
    get_target_property(type ${item} TYPE)
    if(type STREQUAL "STATIC_LIBRARY")
      set_property(GLOBAL APPEND PROPERTY ${out_libs} "$<TARGET_FILE:${item}>")
    elseif(type STREQUAL "UNKNOWN_LIBRARY")
      # Find modules (OpenSSL, LibArchive): a file, a framework or a system library.
      foreach(p IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION)
        get_target_property(file ${item} ${p})
        if(file)
          lexipeek_collect(${file} ${out_libs} ${out_flags})
          break()
        endif()
      endforeach()
    endif()
    get_target_property(deps ${item} INTERFACE_LINK_LIBRARIES)
    get_target_property(imported ${item} IMPORTED)
    if(NOT imported)
      get_target_property(own ${item} LINK_LIBRARIES)
      if(own)
        list(APPEND deps ${own})
      endif()
    endif()
    foreach(d IN LISTS deps)
      if(d)
        lexipeek_collect(${d} ${out_libs} ${out_flags})
      endif()
    endforeach()
  elseif(item MATCHES "\\.framework$")
    get_filename_component(name ${item} NAME_WE)
    set_property(GLOBAL APPEND PROPERTY ${out_flags} "-framework ${name}")
  elseif(item MATCHES "\\.a$")
    set_property(GLOBAL APPEND PROPERTY ${out_libs} ${item})
  elseif(item MATCHES "\\.(dylib|tbd)$")
    get_filename_component(name ${item} NAME_WE)
    string(REGEX REPLACE "^lib" "" name ${name})
    set_property(GLOBAL APPEND PROPERTY ${out_flags} "-l${name}")
  elseif(item MATCHES "^-")
    set_property(GLOBAL APPEND PROPERTY ${out_flags} ${item})
  else()
    set_property(GLOBAL APPEND PROPERTY ${out_flags} "-l${item}")
  endif()
endfunction()

lexipeek_collect(lexipeek_core LEXIPEEK_LIBS LEXIPEEK_FLAGS)
get_property(libs GLOBAL PROPERTY LEXIPEEK_LIBS)
get_property(flags GLOBAL PROPERTY LEXIPEEK_FLAGS)
list(REMOVE_DUPLICATES libs)
list(REMOVE_DUPLICATES flags)
string(REPLACE ";" " " flags "${flags}")
set(out ${CMAKE_BINARY_DIR}/mac)
file(GENERATE OUTPUT ${out}/link.xcconfig CONTENT "LEXIPEEK_LDFLAGS = -llexipeek_all ${flags} -lc++\n")
add_custom_command(OUTPUT ${out}/liblexipeek_all.a
  COMMAND libtool -static -no_warning_for_no_symbols -o ${out}/liblexipeek_all.a ${libs}
  DEPENDS ${libs} lexipeek_core
  COMMAND_EXPAND_LISTS VERBATIM)
add_custom_target(lexipeek_all ALL DEPENDS ${out}/liblexipeek_all.a)
