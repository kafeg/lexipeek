# The engine submodules are at the commits InkPeek's tests/inkpeek pin uses (app/src/main/cpp/<name>).
foreach(name bergamot fasttext llama pcre2)
  execute_process(COMMAND git -C ${ROOT} ls-files --stage engines/${name} OUTPUT_VARIABLE ours OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND git -C ${ROOT}/tests/inkpeek ls-tree HEAD app/src/main/cpp/${name} OUTPUT_VARIABLE theirs OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND git -C ${ROOT}/engines/${name} rev-parse HEAD OUTPUT_VARIABLE checked OUTPUT_STRIP_TRAILING_WHITESPACE)
  string(REGEX MATCH "[0-9a-f]+ 0\t" ours "${ours}")
  string(REPLACE " 0" "" ours "${ours}")
  string(REGEX MATCH "[0-9a-f]+\t" theirs "${theirs}")
  string(STRIP "${ours}" ours)
  string(STRIP "${theirs}" theirs)
  if(theirs STREQUAL "")
    message(FATAL_ERROR "tests/inkpeek has no app/src/main/cpp/${name} (git submodule update --init tests/inkpeek)")
  endif()
  if(NOT ours STREQUAL theirs OR NOT checked STREQUAL theirs)
    message(FATAL_ERROR "engines/${name}: pinned ${ours}, checked out ${checked}, InkPeek uses ${theirs}")
  endif()
  message(STATUS "${name} ${ours}")
endforeach()
