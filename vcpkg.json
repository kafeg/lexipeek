{
  "name": "lexipeek",
  "version-string": "0.0.0",
  "builtin-baseline": "817892b0ecbc6af994dd6df999c73faf795adbf2",
  "dependencies": [
    "sqlite3",
    "nlohmann-json",
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "ssl"
      ]
    },
    "zstd",
    "utf8proc",
    "doctest",
    {
      "name": "libarchive",
      "default-features": false,
      "features": [
        "zstd",
        "bzip2",
        "lzma"
      ]
    },
    "hash-library",
    "zlib",
    {
      "name": "openblas",
      "platform": "!osx",
      "features": [
        {
          "name": "dynamic-arch",
          "platform": "linux"
        }
      ]
    },
    {
      "name": "clapack",
      "platform": "!osx"
    }
  ],
  "features": {
    "qt": {
      "description": "The Qt shell (Windows, Linux): qtbase only",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "widgets",
            "png",
            "concurrent",
            {
              "name": "freetype",
              "platform": "linux"
            },
            {
              "name": "harfbuzz",
              "platform": "linux"
            },
            {
              "name": "fontconfig",
              "platform": "linux"
            }
          ]
        }
      ]
    }
  }
}
